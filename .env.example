# =========================
# DOCKER / INFRA
# =========================

# Override das imagens usadas pelo docker-compose.
# Por padrão, o compose puxa as imagens publicadas no GHCR (ghcr.io/ifpbesp/...).
# Descomente as 3 linhas abaixo para usar imagens buildadas localmente com:
#   docker build -t apae-geral-backend:local  ./apps/api
#   docker build -t apae-geral-frontend:local ./apps/apae
# BACKEND_IMAGE=apae-geral-backend
# FRONTEND_IMAGE=apae-geral-frontend
# IMAGE_TAG=local

POSTGRES_DB=apae
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5200
POSTGRES_CONTAINER=apae-postgres
POSTGRES_HOST=localhost

MINIO_ROOT_USER=ROOTUSER
MINIO_ROOT_PASSWORD=CHANGEME123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_PATH=/home/seu-usuario/minio/data

# =========================
# API - SPRING
# =========================
API_PORT=8090
DB_URL=jdbc:postgresql://localhost:5200/apae
DB_USERNAME=user
DB_PASSWORD=pass

JWT_SECRET=U29tZVNlY3JldEF0TGVhc3QtMjU2Qml0cw==
JWT_EXPIRATION_HOURS=24

# Valor para rodar via `pnpm dev` (backend no host, MinIO em container).
# Em `docker compose up`, o compose sobrescreve com http://minio:9000 automaticamente.
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=ROOTUSER
MINIO_SECRET_KEY=CHANGEME123

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Use aspas se a senha contiver espaços
MAIL_USERNAME=
MAIL_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000

APP_FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/apae-geral/auth/reset-password


# =========================
# FRONTEND - APAE
# =========================
# O frontend roda sob basePath /apae-geral e o backend sob context-path /apae-geral.
# Em produção (atrás de Nginx), o Nginx mantém o prefixo /apae-geral ao fazer proxy.
# Documentos usam fluxo canônico via Spring API/BFF, não acesso direto ao MinIO.
NEXT_PUBLIC_API_URL=http://localhost:8090/apae-geral/api
NEXT_PUBLIC_DOCUMENTS_API_URL=http://localhost:8090/apae-geral/api
NEXT_PUBLIC_USE_MOCK_DATA=false
