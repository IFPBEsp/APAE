{
  "name": "@apae/source",
  "version": "1.0.0",
  "description": "apae pnpm workspace monorepo",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:drop": "docker compose down -v",
    "dev:infra": "docker compose up -d db minio",
    "dev:backend": "bash ./.scripts/run-app.sh backend",
    "dev:apae": "bash ./.scripts/run-app.sh frontend apae",
    "dev": "pnpm dev:infra && bash ./.scripts/run-app.sh both apae",
    "test:api": "cd apps/api && ./mvnw package",
    "db:seed": "bash ./.scripts/setup.sh",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
