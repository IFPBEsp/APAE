{
  "name": "@apae/source",
  "version": "1.0.0",
  "description": "apae pnpm workspace monorepo",
  "scripts": {
    "dev:backend": "./.scripts/run-app.sh backend",
    "dev:agendamento": "./.scripts/run-app.sh both agendamento",
    "dev:management": "./.scripts/run-app.sh both management-app",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:drop": "docker compose down -v",
    "test:api": "cd apps/api && ./mvnw package"
  },
  "workspaces": [
    "apps/*"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
