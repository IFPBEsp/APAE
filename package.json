{
  "name": "@apae/source",
  "version": "1.0.0",
  "description": "apae pnpm workspace monorepo",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:drop": "docker compose down -v",
    "dev:backend": "cd apps/api && mvnw spring-boot:run",
    "dev:apae": "pnpm --filter agendamento dev",
    "dev": "pnpm docker:up && concurrently -k -p \"[{name}]\" -n \"BACK,FRONT\" -c \"green,magenta\" \"pnpm dev:backend\" \"pnpm dev:apae\"",
    "test:api": "cd apps/api && ./mvnw package"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
